# name: test/sql/typed_ai_jev.test
# description: typed_ai against the real Jev API. Costs well under $0.001. Runs only when TYPESAFE_API_KEY is set.
# group: [sql]

require typed_ai

require-env TYPESAFE_API_KEY

statement ok
LOAD httpfs;

# A tight budget: this file must never spend more than a tenth of a cent
statement ok
SET typed_budget_usd = 0.001;

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES
    (1, 'The blender lid cracked the first time I washed it.'),
    (2, 'The parcel arrived three days late and the box was soaked.')) v(id, body);

query II
SELECT id, typed_is(body, 'the reviewer reports a broken part') FROM t ORDER BY id;
----
1	true
2	false

query II
SELECT id, typed_pick(body, 'what is this review mainly about?', ['product quality', 'shipping', 'price']) FROM t ORDER BY id;
----
1	product quality
2	shipping

query I
SELECT typed_score(body, 'how satisfied is the reviewer?', ['very unhappy', 'unhappy', 'neutral', 'happy', 'very happy']) BETWEEN 0 AND 4 FROM t WHERE id = 1;
----
true

query I
SELECT typed_ask(body, '{"v": 1, "type": "yes_no", "question": "reports a broken part"}')::VARCHAR LIKE '%"model":"jev-%"calibrated":true%'
FROM t WHERE id = 1;
----
true

# Photos, from files (Jev's photo support is a preview)
query II
SELECT parse_filename(filename), typed_pick(content, 'what shape is drawn?', ['circle', 'square', 'triangle'])
FROM read_blob('test/data/*') ORDER BY 1;
----
blue_square.png	square
red_circle.jpg	circle

query I
SELECT typed_is(content, 'the shape is red') FROM read_blob('test/data/red_circle.jpg');
----
true

# A photo with the row's other columns
query II
SELECT parse_filename(filename), typed_is({photo: content, note: 'a blue square'}, 'the note correctly describes the photo')
FROM read_blob('test/data/*') ORDER BY 1;
----
blue_square.png	true
red_circle.jpg	false

# Options defined by pictures
query II
SELECT parse_filename(filename), typed_pick(content, 'which picture shows the same thing?',
    (SELECT MAP {'square': any_value(content) FILTER (filename LIKE '%square%'),
                 'circle': any_value(content) FILTER (filename LIKE '%circle%'), 'neither': NULL::BLOB}
     FROM read_blob('test/data/*')))
FROM read_blob('test/data/*') ORDER BY 1;
----
blue_square.png	square
red_circle.jpg	circle

# Where is it: the circle sits in the middle of its picture
query I
SELECT b.left < 0.5 AND b.right > 0.5 AND b.top < 0.5 AND b.bottom > 0.5 AND b.confidence > 0
FROM (SELECT typed_box(content, 'the red circle') b FROM read_blob('test/data/red_circle.jpg'));
----
true

query I
SELECT spent_usd > 0 AND spent_usd < 0.001 FROM typed_usage();
----
true
